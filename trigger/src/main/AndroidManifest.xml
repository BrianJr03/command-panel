<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signature permissions declared by each Command Panel build; granted only when signed with the same key and
         installed after that build. -->
    <uses-permission android:name="jr.brian.commandpannel.permission.TRIGGER" />
    <uses-permission android:name="jr.brian.commandpannel.debug.permission.TRIGGER" />

    <queries>
        <package android:name="jr.brian.commandpannel" />
        <package android:name="jr.brian.commandpannel.debug" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">
        <!-- Invisible and gone at once, so a launch from the bottom screen leaves the game on top in focus. -->
        <activity
            android:name=".SaveClipActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.SaveClip">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
