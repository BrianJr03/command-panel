<?xml version="1.0" encoding="utf-8"?>
<layer-list android:paddingMode="stack"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:gravity="fill_horizontal|center" android:id="@android:id/background">
        <shape>
            <size android:height="8.0dp" />
            <corners android:radius="5.0dp" />
            <solid android:color="@color/fan_control_bar_background" />
        </shape>
    </item>
    <item android:gravity="fill_horizontal|center" android:id="@android:id/progress">
        <clip>
            <shape>
                <size android:height="8.0dp" />
                <solid android:color="#929292" />
                <corners android:radius="5.0dp" />
            </shape>
        </clip>
    </item>
</layer-list>
